# 只给 build-arm.yml 用：构建 linux/arm64 镜像。
#
# 基础镜像是 Oracle GraalVM（企业版）的 arm64 变体：JDK 25.0.4 + glibc（Oracle Linux 8）。
#   container-registry.oracle.com/graalvm/native-image:25i4-25.0.4.1.1-ol8-20260922
#
# 为什么选 ol8 而不是 ol10（glibc 版本决定产物能在哪台机器上跑）：
#   glibc 向后兼容、不向前兼容 —— 在 glibc 2.39 上编译的二进制，放到 glibc 2.31 的
#   系统上会因为找不到 GLIBC_2.32+ 的符号而直接报
#     version `GLIBC_2.34' not found
#   目标部署机是银河麒麟 V10 SP1（基于 Ubuntu 20.04，glibc 2.31），所以必须用
#   更低的 glibc 来构建。Oracle GraalVM 的 arm64 提供三个 Oracle Linux 变体：
#     ol8  → glibc 2.28   ← 选它，2.28 < 2.31，向下兼容，产物在麒麟上可运行
#     ol9  → glibc 2.34   （2.34 > 2.31，有风险）
#     ol10 → glibc 2.39   （2.39 > 2.31，会失败）
#   三个变体都有 arm64，只有 glibc 版本不同。
#
# 其它选型理由：
#   1. 优先 Oracle GraalVM 的 arm 版本，且是 JDK 25.0.4 —— 该 tag 正好满足。
#   2. Oracle 的 *-muslib-* 系列至今全部只有 amd64，arm64 只出现在 glibc 系列。
#   3. 必须用 glibc 而不是 musl：云效会往构建环境注入自己的工具链（node16 等），
#      那些二进制是 glibc 编译的。musl 镜像里只有 ld-musl-aarch64.so.1，没有
#      ld-linux-aarch64.so.1，云效的 node 会直接报
#        cannot execute: required file not found
#      （musl 下动态链接器缺失的经典误导性报错）。Alpaquita 的 musl 仓库里也没有
#      gcompat / libc6-compat，无法加兼容层。
#   4. 该镜像自带 bash、microdnf、gcc 工具链和 native-image，精简掉的东西少。
#
# 本地构建：
#   docker build --platform linux/arm64 -f Dockerfile.arm -t test-arm .
#
# 注意：阿里云云效要求自定义镜像必须包含 bash 和 jq，且默认用户为 root
# （见 https://help.aliyun.com/zh/yunxiao/user-guide/custom-build-environment ）。
# 本镜像自带 bash；jq 与 git 在 OL8 的 appstream 仓库（该仓库默认 enabled=1）。
ARG BASE_IMAGE=container-registry.oracle.com/graalvm/native-image:25i4-25.0.4.1.1-ol8-20260922
ARG MAVEN_VERSION=3.9.16
FROM ${BASE_IMAGE}

# ARG 在 FROM 之后会失效，必须在当前阶段重新声明，RUN 里才能用到它的值
ARG MAVEN_VERSION

# jq 是云效的硬性要求（bash 基镜像自带）。git 供流水线拉代码/提交用。
# binutils 提供 readelf，用于构建期校验产物引用的 GLIBC 符号版本。
# OL8 的 jq/git 在 appstream 仓库，需确保该仓库启用（镜像默认已启用）。
RUN if command -v microdnf >/dev/null 2>&1; then \
      microdnf --nodocs --setopt=install_weak_deps=0 --enablerepo=ol8_appstream \
        install -y jq git-core pigz tar gzip which binutils \
      && microdnf clean all; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash jq git curl ca-certificates binutils; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends bash jq git curl ca-certificates binutils \
      && rm -rf /var/lib/apt/lists/*; \
    fi \
 && curl -fL --connect-timeout 10 --retry 2 --retry-delay 3 --max-time 180 \
      -o /tmp/apache-maven.tgz \
      "https://mirrors.aliyun.com/apache/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
 && mkdir -p /opt /workspace \
 && tar -xzf /tmp/apache-maven.tgz -C /opt \
 && ln -sfn /opt/apache-maven-${MAVEN_VERSION} /opt/maven \
 && rm -f /tmp/apache-maven.tgz /opt/apache-maven-${MAVEN_VERSION}/bin/*.cmd \
 && rm -rf /var/cache/dnf /var/cache/yum /var/cache/apk/* /root/.cache /tmp/* /var/tmp/*

# 只删 man 和 src.zip，不删 jmods：native-image 在部分版本上会依赖 jmods，
# 为省几十 MB 冒构建失败的风险不值得。
RUN rm -rf "${JAVA_HOME}/man" "${JAVA_HOME}/lib/src.zip"

# 防止 login shell 下 PATH 被 /etc/profile 之类脚本覆盖导致 mvn/java 丢失。
# Oracle Linux 的 /etc/profile 本身是追加式（不像 Alpaquita 那样直接赋值覆盖），
# 但这里仍然加一层幂等兜底，保证云效用 bash 起容器时工具一定在 PATH 上。
RUN printf '%s\n' \
      '# 保证 mvn 与 JDK 在 login shell 下也可用（幂等）' \
      'case ":$PATH:" in' \
      '  *:/opt/maven/bin:*) ;;' \
      '  *) export PATH="/opt/maven/bin:$PATH" ;;' \
      'esac' \
      'if [ -n "${JAVA_HOME:-}" ] && [ -d "$JAVA_HOME/bin" ]; then' \
      '  case ":$PATH:" in' \
      '    *:"$JAVA_HOME/bin":*) ;;' \
      '    *) export PATH="$JAVA_HOME/bin:$PATH" ;;' \
      '  esac' \
      'fi' \
      > /etc/profile.d/00-graalvm-path.sh \
 && chmod 0644 /etc/profile.d/00-graalvm-path.sh \
 && bash -lc 'command -v mvn >/dev/null && command -v java >/dev/null' \
 && echo "login shell PATH 检查通过"

COPY maven-settings.xml /opt/maven/conf/settings.xml

ENV MAVEN_HOME=/opt/maven \
    PATH=/opt/maven/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
ENTRYPOINT []
# 云效会以 /bin/bash 作为 entrypoint 起容器，这里保证 bash 存在
USER root
CMD ["/bin/bash"]

# 构建期就把云效的前提卡死，缺任何一项直接让构建失败，不把问题留到流水线上。
# 必须放在 ENV PATH 之后，否则 mvn 还不在 PATH 里，会被误判为缺失。
# 同时用 bash -lc（login shell）复现云效的启动方式。
# 关键一条：必须存在 glibc 动态链接器 ld-linux-aarch64.so.1，
# 否则云效注入的 glibc 二进制（node16 等）会报 required file not found。
RUN set -e; \
    for t in bash jq java javac native-image mvn git readelf; do \
      command -v "$t" >/dev/null 2>&1 || { echo "缺少必需命令: $t" >&2; exit 1; }; \
    done; \
    [ -x /bin/bash ] || { echo "缺少 /bin/bash" >&2; exit 1; }; \
    echo '{"ok":true}' | jq -e '.ok == true' >/dev/null || { echo "jq 不可用" >&2; exit 1; }; \
    [ "$(id -u)" = "0" ] || { echo "默认用户不是 root" >&2; exit 1; }; \
    { ls /usr/lib/ld-linux-aarch64.so.1 /usr/lib64/ld-linux-aarch64.so.1 /lib/ld-linux-aarch64.so.1 >/dev/null 2>&1 \
      || ldconfig -p 2>/dev/null | grep -q 'ld-linux-aarch64'; } \
      || { echo "缺少 glibc 动态链接器 ld-linux-aarch64.so.1，云效的 node 会跑不起来" >&2; exit 1; }; \
    bash -lc 'for t in mvn java javac native-image jq; do command -v "$t" >/dev/null || { echo "login shell 下缺少 $t" >&2; exit 1; }; done'; \
    echo "前置检查通过: bash=$(bash --version | head -1) jq=$(jq --version) mvn=$(mvn -v | head -1) libc=$(ldd --version 2>&1 | head -1)"

# 卡死 glibc 版本：目标部署机是银河麒麟 V10 SP1（glibc 2.31），
# 构建机的 glibc 必须 <= 2.31，否则产出的二进制在目标机上会报
#   version `GLIBC_2.xx' not found
# 这里取 2.28（Oracle Linux 8），留出余量。上限写死 2.31，防止以后误换回 ol9/ol10。
RUN set -e; \
    V=$(ldd --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+$'); \
    echo "构建机 glibc = $V"; \
    [ "$(printf '%s\n' "$V" "2.31" | sort -V | tail -1)" = "2.31" ] \
      || { echo "构建机 glibc $V 高于目标机麒麟 V10 SP1 的 2.31，产物会不兼容" >&2; exit 1; }; \
    echo "glibc 版本检查通过（$V <= 2.31）"
